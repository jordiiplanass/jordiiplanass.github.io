---
// Editorial project rows: big art panel + body, sides alternate. Shared by the
// home teaser and the /projects listing page.
interface Item {
  slug: string;
  title: string;
  year?: number;
  tags?: string[];
  cover?: string;
  summary?: string;
}
interface Props { items: Item[]; viewLabel: string; base?: string; }
const { items, viewLabel, base = '/projects' } = Astro.props;
---

<ol class="proj-list">
  {items.map((p, i) => {
    const initials = p.title.replace(/[^A-Za-zÀ-ÿ ]/g, '').split(' ').filter(Boolean).slice(0, 2).map((w) => w[0]).join('');
    return (
      <li class="proj" data-reveal style={`--i:${i}`}>
        <a class="proj-in" href={`${base}/${p.slug}`}>
          <div class="proj-art" aria-hidden="true">
            <span class="proj-idx">{String(i + 1).padStart(2, '0')}</span>
            {p.cover
              ? <img src={p.cover} alt="" loading="lazy" />
              : <span class="proj-mono">{initials}</span>}
          </div>
          <div class="proj-body">
            <div class="proj-top">
              <h3>{p.title}</h3>
              <span class="proj-year">{p.year}</span>
            </div>
            {p.summary && <p class="proj-sum">{p.summary}</p>}
            {p.tags && p.tags.length > 0 && (
              <ul class="tags">{p.tags.map((tname) => <li>{tname}</li>)}</ul>
            )}
            <span class="proj-go">{viewLabel}<i>→</i></span>
          </div>
        </a>
      </li>
    );
  })}
</ol>

<style>
  .proj-list { list-style: none; display: flex; flex-direction: column; gap: clamp(20px, 4vh, 44px); }
  .proj-in {
    display: grid; grid-template-columns: 0.9fr 1.1fr; align-items: stretch;
    gap: clamp(20px, 4vw, 48px);
    border-top: 1px solid var(--line); padding-top: clamp(20px, 4vh, 40px);
  }
  .proj:nth-child(even) .proj-in { grid-template-columns: 1.1fr 0.9fr; }
  .proj:nth-child(even) .proj-art { order: 2; }

  .proj-art {
    position: relative; overflow: hidden;
    aspect-ratio: 16 / 10; border-radius: 14px; border: 1px solid var(--line);
    display: grid; place-items: center;
    background:
      radial-gradient(120% 120% at 28% 16%, color-mix(in srgb, var(--accent) 24%, #1c1f22), #15171a);
  }
  .proj-art img { width: 100%; height: 100%; object-fit: cover; }
  .proj-mono {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(54px, 9vw, 104px); letter-spacing: -0.04em;
    color: color-mix(in srgb, var(--accent) 60%, #76797a);
    transition: transform 0.5s cubic-bezier(0.16,1,0.3,1);
  }
  .proj-idx {
    position: absolute; top: 14px; left: 16px;
    font-family: var(--font-mono); font-size: 12px; color: var(--mute); letter-spacing: 0.1em;
  }
  .proj-in:hover .proj-mono { transform: scale(1.06); }
  .proj-in:hover .proj-art { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }

  .proj-body { align-self: center; }
  .proj-top { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; }
  .proj-top h3 {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(24px, 3vw, 40px); letter-spacing: -0.02em; line-height: 1.02;
    transition: color 0.25s ease;
  }
  .proj-in:hover .proj-top h3 { color: var(--accent); }
  .proj-year { color: var(--mute); font-size: 13px; font-variant-numeric: tabular-nums; }
  .proj-sum { color: var(--mute); font-size: 15px; line-height: 1.55; margin-top: 12px; max-width: 48ch; }
  .proj-go {
    display: inline-flex; align-items: center; gap: 7px; margin-top: 18px;
    color: var(--accent); font-size: 14px; font-weight: 600;
  }
  .proj-go i { font-style: normal; transition: transform 0.3s ease; }
  .proj-in:hover .proj-go i { transform: translateX(5px); }

  .tags { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
  .tags li {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.02em;
    color: var(--mute); border: 1px solid var(--line); border-radius: 6px; padding: 3px 8px;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .proj-in:hover .tags li { border-color: color-mix(in srgb, var(--accent) 35%, var(--line)); color: var(--ink); }

  @media (max-width: 760px) {
    .proj-in,
    .proj:nth-child(even) .proj-in { grid-template-columns: 1fr; gap: 16px; }
    .proj:nth-child(even) .proj-art { order: 0; }
    /* Todo pegado al borde izquierdo: separador, art y texto comparten margen. */
    .proj-body { align-self: start; }
    .proj-sum, .proj-top h3 { max-width: none; }
    .tags { gap: 6px 8px; }
    .tags li { font-size: 11px; }
  }
</style>
