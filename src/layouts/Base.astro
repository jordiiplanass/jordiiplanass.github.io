---
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}
const {
  title = 'Jordi Planas — Game Programmer',
  description = 'Portfolio de Jordi Planas, programador de videojuegos.',
  lang = 'es',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Fonts: Cabinet Grotesk (display) + General Sans (body), via Fontshare CDN -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@400,700,800&f[]=general-sans@400,500,600&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/png" href="/icon.png" />
    <ClientRouter />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      import Lenis from 'lenis';
      const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

      // --- Section-jacking scroll ---
      // One gesture = one section. We don't follow the trackpad delta; we read its
      // direction and animate to the next/prev section, then lock until it lands.
      // Disabled on narrow screens and reduced-motion (native scroll there).
      function initLenis() {
        if (reduce() || (window as any).__lenis) return;
        const sections = () =>
          [...document.querySelectorAll<HTMLElement>('[data-snap]'),
           ...[...document.querySelectorAll<HTMLElement>('footer')]];
        const jacking = () => window.innerWidth >= 860 && sections().length > 1;

        // Lenis only powers the programmatic smooth scrollTo (not free wheel).
        const lenis = new Lenis({ smoothWheel: false, lerp: 0.1 });
        (window as any).__lenis = lenis;

        // Parallax for [data-speed].
        lenis.on('scroll', () => {
          const y = lenis.scroll;
          document.querySelectorAll<HTMLElement>('[data-speed]').forEach((el) => {
            el.style.transform = `translate3d(0, ${y * parseFloat(el.dataset.speed || '0')}px, 0)`;
          });
        });
        function raf(t: number) { lenis.raf(t); requestAnimationFrame(raf); }
        requestAnimationFrame(raf);

        const ease = (x: number) => 1 - Math.pow(1 - x, 3);
        let animating = false;
        let idx = 0;

        const nearest = () => {
          const els = sections();
          const y = window.scrollY + window.innerHeight / 2;
          let bi = 0, bd = Infinity;
          els.forEach((s, i) => {
            const c = s.offsetTop + s.offsetHeight / 2;
            const d = Math.abs(c - y);
            if (d < bd) { bd = d; bi = i; }
          });
          return bi;
        };

        const go = (dir: number) => {
          const els = sections();
          idx = Math.max(0, Math.min(els.length - 1, nearest() + dir));
          animating = true;
          lenis.scrollTo(els[idx], {
            duration: 0.85,
            easing: ease,
            lock: true,
            onComplete: () => { setTimeout(() => { animating = false; }, 90); },
          });
        };

        // Trackpad / mouse wheel: direction only, ignore magnitude and momentum.
        window.addEventListener('wheel', (e) => {
          if (!jacking()) return;
          e.preventDefault();
          if (animating || Math.abs(e.deltaY) < 6) return;
          go(e.deltaY > 0 ? 1 : -1);
        }, { passive: false });

        // Keyboard.
        window.addEventListener('keydown', (e) => {
          if (!jacking() || animating) return;
          if (['ArrowDown', 'PageDown', ' '].includes(e.key)) { e.preventDefault(); go(1); }
          else if (['ArrowUp', 'PageUp'].includes(e.key)) { e.preventDefault(); go(-1); }
        });

        // Touch swipe (only when jacking, i.e. >=860px touchscreens).
        let touchY = 0;
        window.addEventListener('touchstart', (e) => { touchY = e.touches[0].clientY; }, { passive: true });
        window.addEventListener('touchend', (e) => {
          if (!jacking() || animating) return;
          const dy = touchY - e.changedTouches[0].clientY;
          if (Math.abs(dy) > 40) go(dy > 0 ? 1 : -1);
        }, { passive: true });

        // Anchor links route through the same animated jump.
        document.addEventListener('click', (e) => {
          const a = (e.target as HTMLElement).closest('a[href^="#"], a[href*="/#"]');
          if (!a) return;
          const id = (a.getAttribute('href') || '').split('#')[1];
          const el = id && document.getElementById(id);
          if (el) { e.preventDefault(); animating = true; lenis.scrollTo(el, { duration: 0.85, easing: ease, lock: true, onComplete: () => { animating = false; } }); }
        });

        idx = nearest();
      }

      // --- Reveal-on-scroll: direction-aware + re-triggering. ---
      // Each [data-reveal] slides in horizontally from the side opposite to the
      // scroll direction (down -> from left, up -> from right; CSS reads data-dir),
      // and re-animates every time it re-enters the viewport. Reduced-motion shows
      // everything instantly.
      function initReveal() {
        // Tell the CSS it may hide things now. Until this lands, [data-reveal] is
        // fully visible, so a failure anywhere above (the `lenis` import, a syntax
        // error, JS disabled) leaves the content readable instead of invisible.
        document.documentElement.classList.add('reveal-ready');

        const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
        if (reduce()) { els.forEach((el) => el.classList.add('is-in')); return; }

        // init() can fire twice (readyState check + astro:page-load); one observer
        // per element is enough.
        const w0 = window as any;
        if (w0.__revIO) w0.__revIO.disconnect();

        // Shared scroll-direction tracker, installed once (survives SPA nav).
        const w = window as any;
        if (!w.__revDir) {
          w.__revDir = { dir: 'down', lastY: window.scrollY };
          window.addEventListener('scroll', () => {
            const y = window.scrollY;
            if (Math.abs(y - w.__revDir.lastY) > 2) {
              w.__revDir.dir = y > w.__revDir.lastY ? 'down' : 'up';
              w.__revDir.lastY = y;
            }
          }, { passive: true });
        }

        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            const el = e.target as HTMLElement;
            if (e.isIntersecting) {
              if (!el.classList.contains('is-in')) el.dataset.dir = w.__revDir.dir;
              el.classList.add('is-in');
            } else {
              el.classList.remove('is-in');
              el.dataset.dir = w.__revDir.dir; // arm the next entry's direction
            }
          }
        }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });

        w0.__revIO = io;
        els.forEach((el) => { if (!el.dataset.dir) el.dataset.dir = 'down'; io.observe(el); });
      }

      // Reveal first: it decides whether content is visible at all, so it must not
      // depend on the scroll-jacking setup succeeding.
      function init() {
        initReveal();
        try { initLenis(); } catch (e) { console.warn('Lenis init failed, native scroll', e); }
      }
      document.addEventListener('astro:page-load', init);
      if (document.readyState !== 'loading') init();
      else document.addEventListener('DOMContentLoaded', init);
    </script>
  </body>
</html>
